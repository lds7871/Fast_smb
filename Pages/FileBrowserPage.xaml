<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:l10n="clr-namespace:Fast_smb.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Fast_smb.Models"
             xmlns:controls="clr-namespace:Fast_smb.Controls"
             x:Class="Fast_smb.Pages.FileBrowserPage"
             Title="{Binding [browser_title], Source={x:Static l10n:L10n.Instance}}"
             BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">

    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">

    <!-- 统一顶栏（单行/多行共用同一套控件与样式，仅行数不同）：
         第一行靠左：退出图标 + 文件路径；功能按钮靠右（单行时与路径同行，多行时在第二行） -->
        <Grid x:Name="TopToolbar"
          Grid.Row="0"
          Padding="4,4"
          RowDefinitions="Auto"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="4"
          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
        <!-- 退出图标（Image 严格尊重尺寸；外层 Grid 44px 保证点击区域） -->
        <Grid Grid.Row="0" Grid.Column="0"
              WidthRequest="44" HeightRequest="44">
            <Image x:Name="ExitBtn"
                   Source="exit.png"
                   WidthRequest="25" HeightRequest="25"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitTapped" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>
        <Label x:Name="PathLabel"
               Grid.Row="0" Grid.Column="1"
               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}"
               FontSize="17"
               VerticalOptions="Center"
               LineBreakMode="MiddleTruncation" />
        <HorizontalStackLayout x:Name="FuncBar"
                               Grid.Row="0" Grid.Column="2"
                               HorizontalOptions="End" Spacing="2">
            <controls:ToolbarButton Text="{Binding [toolbar_up], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnUpClicked"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}"
                    FontSize="14" HeightRequest="40" Padding="10,0" />
            <controls:ToolbarButton Text="{Binding [toolbar_refresh], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnRefreshClicked"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}"
                    FontSize="14" HeightRequest="40" Padding="10,0" />
            <controls:ToolbarButton Text="{Binding [toolbar_upload], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnUploadClicked"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}"
                    FontSize="14" HeightRequest="40" Padding="10,0" />
            <controls:ToolbarButton Text="{Binding [toolbar_search], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnSearchClicked"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}"
                    FontSize="14" HeightRequest="40" Padding="10,0" />
            <controls:ToolbarButton x:Name="MultiBatchBtn" Text="{Binding [toolbar_batch], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnBatchToggleClicked"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}"
                    FontSize="14" HeightRequest="40" Padding="10,0" />
        </HorizontalStackLayout>
        </Grid>




        <!-- 搜索栏（点击顶栏「搜索」弹出） -->
        <Grid x:Name="SearchBar"
              Grid.Row="1"
              IsVisible="False"
              Padding="14,8"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}">
            <Entry x:Name="SearchEntry"
                   Placeholder="{Binding [search_placeholder], Source={x:Static l10n:L10n.Instance}}"
                   TextChanged="OnSearchTextChanged"
                   ClearButtonVisibility="WhileEditing"
                   ReturnType="Search"
                   TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                   PlaceholderColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}"
                   HeightRequest="44"
                   FontSize="15" />
            <Button Grid.Column="1"
                    Text="{Binding [cancel], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnSearchCancelClicked"
                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                    HeightRequest="44" CornerRadius="9" FontSize="14"
                    Padding="18,0" />
        </Grid>

        <!-- 内容区（文件列表 + 空提示） -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="FileList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="16,12"
                              ColumnDefinitions="Auto,*,Auto"
                              BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEntryTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0"
                                                 VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}"
                                       TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="16"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayInfo}"
                                       TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- 文件夹：进入箭头 -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   TextColor="{AppThemeBinding Dark={StaticResource LinkDark}, Light={StaticResource LinkLight}}" FontSize="20"
                                   IsVisible="{Binding IsDirectory}"
                                   VerticalOptions="Center" />
                            <!-- 文件：单个下载按钮（非批量模式） -->
                            <Button Grid.Column="2"
                                    Text="{Binding [download_btn], Source={x:Static l10n:L10n.Instance}}"
                                    IsVisible="{Binding ShowDownloadButton}"
                                    Clicked="OnDownloadClicked"
                                    BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                                    FontSize="13" HeightRequest="38" CornerRadius="9"
                                    Padding="14,0" VerticalOptions="Center" />
                            <!-- 文件：批量勾选框 -->
                            <CheckBox Grid.Column="2"
                                      IsVisible="{Binding ShowCheckbox}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      CheckedChanged="OnItemCheckedChanged"
                                      Color="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                                      VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="EmptyLabel"
                   Text="{Binding [dir_empty], Source={x:Static l10n:L10n.Instance}}"
                   TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="15"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   IsVisible="False" />
        </Grid>

        <!-- 下载进度面板（悬浮顶部） -->
        <Grid x:Name="ProgressPanel"
              Grid.Row="0" Grid.RowSpan="3"
              IsVisible="False"
              Padding="14,10"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}"
              VerticalOptions="Start">
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="0" Grid.ColumnSpan="2"
                         ProgressColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                         BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}"
                         HeightRequest="6" />
            <Label x:Name="ProgressLabel"
                   Grid.Row="1" Grid.Column="0"
                   TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="13"
                   Margin="0,6,0,0" VerticalOptions="Center" />
            <Button x:Name="CancelBtn"
                    Grid.Row="1" Grid.Column="1"
                    Text="{Binding [cancel], Source={x:Static l10n:L10n.Instance}}" FontSize="13"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource ErrorDark}, Light={StaticResource ErrorLight}}"
                    HeightRequest="32" Padding="14,0"
                    Margin="10,4,0,0"
                    Clicked="OnCancelClicked" />
        </Grid>

        <!-- 底部批量操作面板 -->
        <Border x:Name="BatchPanel"
                Grid.Row="0" Grid.RowSpan="3"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}"
                Stroke="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="12,10"
                Margin="10,0,10,14"
                VerticalOptions="End">
            <VerticalStackLayout Spacing="8">
                <Button x:Name="BatchDownloadBtn"
                        Text="{Binding [download_selected], Source={x:Static l10n:L10n.Instance}}"
                        Clicked="OnBatchDownloadClicked"
                        BackgroundColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}" TextColor="{AppThemeBinding Dark={StaticResource TextOnAccentDark}, Light={StaticResource TextOnAccentLight}}"
                        HeightRequest="48" CornerRadius="10"
                        FontSize="16" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Text="{Binding [select_all], Source={x:Static l10n:L10n.Instance}}" Clicked="OnSelectAll"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                    <Button Grid.Column="1" Text="{Binding [invert], Source={x:Static l10n:L10n.Instance}}" Clicked="OnInvertSelection"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                    <Button Grid.Column="2" Text="{Binding [select_none], Source={x:Static l10n:L10n.Instance}}" Clicked="OnSelectNone"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                    <Button Grid.Column="3" Text="{Binding [cancel_batch], Source={x:Static l10n:L10n.Instance}}" Clicked="OnCancelBatch"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource ErrorDark}, Light={StaticResource ErrorLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 目录加载动画（覆盖整个页面，加载期间不显示上一级内容） -->
        <Grid x:Name="LoadingPanel"
              Grid.Row="0" Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                                   WidthRequest="48" HeightRequest="48" />
                <Label Text="{Binding [loading_dir], Source={x:Static l10n:L10n.Instance}}"
                       TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}"
                       FontSize="14" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- 顶部下滑横幅 -->
        <controls:TopBannerView x:Name="Banner"
                                Grid.Row="0" Grid.RowSpan="3"
                                VerticalOptions="Start"
                                HorizontalOptions="Fill" />
    </Grid>

</ContentPage>
