<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Fast_smb.Models"
             xmlns:controls="clr-namespace:Fast_smb.Controls"
             x:Class="Fast_smb.Pages.FileBrowserPage"
             Title="文件"
             BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="上级" Clicked="OnUpClicked" />
        <ToolbarItem Text="刷新" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="搜索" Clicked="OnSearchClicked" />
        <ToolbarItem x:Name="BatchItem" Text="批量" Clicked="OnBatchToggleClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">

        <!-- 搜索栏（点击顶栏「搜索」弹出） -->
        <Grid x:Name="SearchBar"
              Grid.Row="0"
              IsVisible="False"
              Padding="14,8"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}">
            <Entry x:Name="SearchEntry"
                   Placeholder="搜索当前目录文件名…"
                   TextChanged="OnSearchTextChanged"
                   ClearButtonVisibility="WhileEditing"
                   ReturnType="Search"
                   TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                   PlaceholderColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}"
                   HeightRequest="44"
                   FontSize="15" />
            <Button Grid.Column="1"
                    Text="取消"
                    Clicked="OnSearchCancelClicked"
                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                    HeightRequest="44" CornerRadius="9" FontSize="14"
                    Padding="18,0" />
        </Grid>

        <!-- 内容区（文件列表 + 空提示） -->
        <Grid Grid.Row="1">
            <CollectionView x:Name="FileList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SmbEntry">
                        <Grid Padding="16,12"
                              ColumnDefinitions="Auto,*,Auto"
                              BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEntryTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0"
                                                 VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}"
                                       TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="16"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayInfo}"
                                       TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- 文件夹：进入箭头 -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   TextColor="{AppThemeBinding Dark={StaticResource LinkDark}, Light={StaticResource LinkLight}}" FontSize="20"
                                   IsVisible="{Binding IsDirectory}"
                                   VerticalOptions="Center" />
                            <!-- 文件：单个下载按钮（非批量模式） -->
                            <Button Grid.Column="2"
                                    Text="⬇ 下载"
                                    IsVisible="{Binding ShowDownloadButton}"
                                    Clicked="OnDownloadClicked"
                                    BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                                    FontSize="13" HeightRequest="38" CornerRadius="9"
                                    Padding="14,0" VerticalOptions="Center" />
                            <!-- 文件：批量勾选框 -->
                            <CheckBox Grid.Column="2"
                                      IsVisible="{Binding ShowCheckbox}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      CheckedChanged="OnItemCheckedChanged"
                                      Color="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                                      VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="EmptyLabel"
                   Text="此目录为空"
                   TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="15"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   IsVisible="False" />
        </Grid>

        <!-- 下载进度面板（悬浮顶部） -->
        <Grid x:Name="ProgressPanel"
              Grid.Row="0" Grid.RowSpan="2"
              IsVisible="False"
              Padding="14,10"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}"
              VerticalOptions="Start">
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="0" Grid.ColumnSpan="2"
                         ProgressColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                         BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}"
                         HeightRequest="6" />
            <Label x:Name="ProgressLabel"
                   Grid.Row="1" Grid.Column="0"
                   TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="13"
                   Margin="0,6,0,0" VerticalOptions="Center" />
            <Button x:Name="CancelBtn"
                    Grid.Row="1" Grid.Column="1"
                    Text="取消" FontSize="13"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource ErrorDark}, Light={StaticResource ErrorLight}}"
                    HeightRequest="32" Padding="14,0"
                    Margin="10,4,0,0"
                    Clicked="OnCancelClicked" />
        </Grid>

        <!-- 底部批量操作面板 -->
        <Border x:Name="BatchPanel"
                Grid.Row="0" Grid.RowSpan="2"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}"
                Stroke="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="12,10"
                Margin="10,0,10,14"
                VerticalOptions="End">
            <VerticalStackLayout Spacing="8">
                <Button x:Name="BatchDownloadBtn"
                        Text="下载所选 (0)"
                        Clicked="OnBatchDownloadClicked"
                        BackgroundColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}" TextColor="{AppThemeBinding Dark={StaticResource TextOnAccentDark}, Light={StaticResource TextOnAccentLight}}"
                        HeightRequest="48" CornerRadius="10"
                        FontSize="16" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Text="全选" Clicked="OnSelectAll"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                    <Button Grid.Column="1" Text="反选" Clicked="OnInvertSelection"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                    <Button Grid.Column="2" Text="全不选" Clicked="OnSelectNone"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                    <Button Grid.Column="3" Text="取消批量" Clicked="OnCancelBatch"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}" TextColor="{AppThemeBinding Dark={StaticResource ErrorDark}, Light={StaticResource ErrorLight}}"
                            HeightRequest="42" CornerRadius="9" FontSize="14" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 顶部下滑横幅 -->
        <controls:TopBannerView x:Name="Banner"
                                Grid.Row="0" Grid.RowSpan="2"
                                VerticalOptions="Start"
                                HorizontalOptions="Fill" />
    </Grid>

</ContentPage>
