<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:l10n="clr-namespace:Fast_smb.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Fast_smb.Controls"
             x:Class="Fast_smb.Pages.ConnectPage"
             Title="{Binding [connect_title], Source={x:Static l10n:L10n.Instance}}"
             BackgroundColor="{AppThemeBinding Dark={StaticResource BgDark}, Light={StaticResource BgLight}}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- 输入框：无背景色，暗色主题下仅文字/占位符着亮色 -->
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextOnAccentDark}, Light={StaticResource TextOnAccentLight}}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28,0" Spacing="14" VerticalOptions="Center">

                <Label Text="SMB快连"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                       HorizontalOptions="Center" />

                <Label Text="{Binding [connect_subtitle], Source={x:Static l10n:L10n.Instance}}"
                       FontSize="15"
                       TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,18" />

                <Label Text="{Binding [server_label], Source={x:Static l10n:L10n.Instance}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="14" />
                <Entry x:Name="HostEntry"
                       Placeholder="{Binding [server_placeholder], Source={x:Static l10n:L10n.Instance}}"
                       Keyboard="Plain"
                       ReturnType="Next" />

                <Label Text="{Binding [share_label], Source={x:Static l10n:L10n.Instance}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="14" />
                <Entry x:Name="ShareEntry"
                       Placeholder="{Binding [share_placeholder], Source={x:Static l10n:L10n.Instance}}"
                       Keyboard="Plain"
                       ReturnType="Next" />

                <Label Text="{Binding [user_label], Source={x:Static l10n:L10n.Instance}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="14" />
                <Entry x:Name="UserEntry"
                       Placeholder="{Binding [user_placeholder], Source={x:Static l10n:L10n.Instance}}"
                       ReturnType="Next" />

                <Label Text="{Binding [pass_label], Source={x:Static l10n:L10n.Instance}}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="14" />
                <Entry x:Name="PassEntry"
                       Placeholder="{Binding [pass_placeholder], Source={x:Static l10n:L10n.Instance}}"
                       IsPassword="True"
                       ReturnType="Go"
                       Completed="OnConnectClicked" />

                <!-- 记住输入 -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <CheckBox x:Name="RememberCheck" Color="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}" Grid.Column="0"
                              VerticalOptions="Center" />
                    <Label Text="{Binding [remember], Source={x:Static l10n:L10n.Instance}}"
                           TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}" FontSize="14"
                           Grid.Column="1" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRememberLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Button x:Name="ConnectBtn"
                        Text="{Binding [connect_btn], Source={x:Static l10n:L10n.Instance}}"
                        Clicked="OnConnectClicked"
                        Margin="0,10,0,0" />

                <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False"
                                   Color="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}" HeightRequest="36" />

                <Label x:Name="StatusLabel"
                       TextColor="{AppThemeBinding Dark={StaticResource ErrorDark}, Light={StaticResource ErrorLight}}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- 左上角：源代码仓库按钮 -->
        <Button Text="{Binding [repo_btn], Source={x:Static l10n:L10n.Instance}}"
                Clicked="OnRepoClicked"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                FontSize="15" Padding="14,6"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="12,16,0,0" />

        <!-- 右上角：顶栏布局切换 + 主题切换 + 语言切换 + 帮助 -->
        <HorizontalStackLayout Spacing="4"
                               HorizontalOptions="End" VerticalOptions="Start"
                               Margin="0,16,12,0">
            <!-- 图标用 Image（严格尊重尺寸，MAUI ImageButton 在 Android 不生效 WidthRequest），外层 44px 保证点击区域 -->
            <Grid WidthRequest="44" HeightRequest="44">
                <Image x:Name="ToolbarModeBtn"
                       Source="line.png"
                       WidthRequest="24" HeightRequest="24"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToolbarModeTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
            <Button x:Name="ThemeBtn"
                    Text="🌙"
                    Clicked="OnThemeToggleClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                    FontSize="15" Padding="14,6" />
            <Button x:Name="LangBtn"
                    Text="{Binding [lang_zh], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnLangToggleClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                    FontSize="15" Padding="14,6" />
            <Button Text="{Binding [help_btn], Source={x:Static l10n:L10n.Instance}}"
                    Clicked="OnHelpClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                    FontSize="15" Padding="14,6" />
        </HorizontalStackLayout>

        <!-- 连接注意事项浮层（覆盖当前页面，居中窗口） -->
        <BoxView x:Name="NotesScrim"
                 Color="{AppThemeBinding Dark={StaticResource ScrimDark}, Light={StaticResource ScrimLight}}"
                 Opacity="0"
                 IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNotesCloseClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="NotesCard"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}"
                Stroke="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 16"
                Padding="20,18"
                WidthRequest="360"
                MaximumHeightRequest="880"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Opacity="0"
                Scale="0.94">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Label Text="{Binding [notes_title], Source={x:Static l10n:L10n.Instance}}"
                       TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="18" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <ScrollView Grid.Row="1" MaximumHeightRequest="680">
                    <Label x:Name="NotesLabel"
                           TextColor="{AppThemeBinding Dark={StaticResource TextBodyDark}, Light={StaticResource TextBodyLight}}" FontSize="14"
                           LineBreakMode="WordWrap" />
                </ScrollView>
                <Button Grid.Row="2"
                        Text="{Binding [notes_gotit], Source={x:Static l10n:L10n.Instance}}"
                        Clicked="OnNotesCloseClicked"
                        BackgroundColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}" TextColor="{AppThemeBinding Dark={StaticResource TextOnAccentDark}, Light={StaticResource TextOnAccentLight}}"
                        HeightRequest="44" CornerRadius="10" FontSize="15" />
            </Grid>
        </Border>

        <!-- 源代码仓库浮层 -->
        <BoxView x:Name="RepoScrim"
                 Color="{AppThemeBinding Dark={StaticResource ScrimDark}, Light={StaticResource ScrimLight}}"
                 Opacity="0"
                 IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRepoCloseClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="RepoCard"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Dark={StaticResource SurfaceDark}, Light={StaticResource SurfaceLight}}"
                Stroke="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 16"
                Padding="20,18"
                WidthRequest="360"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Opacity="0"
                Scale="0.94">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding [repo_title], Source={x:Static l10n:L10n.Instance}}"
                       TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}" FontSize="18" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Grid.Row="1"
                       Text="{Binding [repo_url], Source={x:Static l10n:L10n.Instance}}"
                       TextColor="{AppThemeBinding Dark={StaticResource LinkDark}, Light={StaticResource LinkLight}}"
                       FontSize="14" LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="RepoStatus"
                       Grid.Row="2"
                       TextColor="{AppThemeBinding Dark={StaticResource SuccessDark}, Light={StaticResource SuccessLight}}"
                       FontSize="13" HorizontalTextAlignment="Center"
                       IsVisible="False" />
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="{Binding [repo_copy], Source={x:Static l10n:L10n.Instance}}"
                            Clicked="OnRepoCopyClicked"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource Surface2Dark}, Light={StaticResource Surface2Light}}"
                            TextColor="{AppThemeBinding Dark={StaticResource TextPrimaryDark}, Light={StaticResource TextPrimaryLight}}"
                            HeightRequest="46" CornerRadius="10" FontSize="15" />
                    <Button Grid.Column="1"
                            Text="{Binding [repo_open], Source={x:Static l10n:L10n.Instance}}"
                            Clicked="OnRepoOpenClicked"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource AccentDark}, Light={StaticResource AccentLight}}"
                            TextColor="{AppThemeBinding Dark={StaticResource TextOnAccentDark}, Light={StaticResource TextOnAccentLight}}"
                            HeightRequest="46" CornerRadius="10" FontSize="15" />
                </Grid>
                <Button Grid.Row="4"
                        Text="{Binding [repo_close], Source={x:Static l10n:L10n.Instance}}"
                        Clicked="OnRepoCloseClicked"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Dark={StaticResource TextSecondaryDark}, Light={StaticResource TextSecondaryLight}}"
                        HeightRequest="40" CornerRadius="10" FontSize="14" />
            </Grid>
        </Border>

        <!-- 应用内共享选择弹窗 -->
        <controls:SharePickerView x:Name="SharePicker" />
    </Grid>

</ContentPage>
