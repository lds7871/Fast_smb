<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Fast_smb.Controls"
             x:Class="Fast_smb.Pages.ConnectPage"
             Title="连接"
             BackgroundColor="#0D1117"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- 输入框：无背景色，暗色主题下仅文字/占位符着亮色 -->
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#E6EDF3" />
            <Setter Property="PlaceholderColor" Value="#8B949E" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#A371F7" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28,0" Spacing="14" VerticalOptions="Center">

                <Label Text="FastSMB"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="#A371F7"
                       HorizontalOptions="Center" />

                <Label Text="SMB 连接与文件管理"
                       FontSize="15"
                       TextColor="#8B949E"
                       HorizontalOptions="Center"
                       Margin="0,0,0,18" />

                <Label Text="服务器 IP / 主机名" TextColor="#E6EDF3" FontSize="14" />
                <Entry x:Name="HostEntry"
                       Placeholder="例如 192.168.1.100（可带 :端口 或 /共享名）"
                       Keyboard="Plain"
                       ReturnType="Next" />

                <Label Text="共享名（可选，留空自动检测）" TextColor="#E6EDF3" FontSize="14" />
                <Entry x:Name="ShareEntry"
                       Placeholder="例如 WD_DATA"
                       Keyboard="Plain"
                       ReturnType="Next" />

                <Label Text="用户名（可留空）" TextColor="#E6EDF3" FontSize="14" />
                <Entry x:Name="UserEntry"
                       Placeholder="用户名"
                       ReturnType="Next" />

                <Label Text="密码" TextColor="#E6EDF3" FontSize="14" />
                <Entry x:Name="PassEntry"
                       Placeholder="密码"
                       IsPassword="True"
                       ReturnType="Go"
                       Completed="OnConnectClicked" />

                <!-- 记住输入 -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <CheckBox x:Name="RememberCheck" Color="#A371F7" Grid.Column="0"
                              VerticalOptions="Center" />
                    <Label Text="记住输入"
                           TextColor="#8B949E" FontSize="14"
                           Grid.Column="1" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRememberLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Button x:Name="ConnectBtn"
                        Text="连 接"
                        Clicked="OnConnectClicked"
                        Margin="0,10,0,0" />

                <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False"
                                   Color="#A371F7" HeightRequest="36" />

                <Label x:Name="StatusLabel"
                       TextColor="#F85149"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- 右上角帮助按钮 -->
        <Button Text="帮助"
                Clicked="OnHelpClicked"
                BackgroundColor="Transparent" TextColor="#A371F7"
                FontSize="15" Padding="14,6"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,16,12,0" />

        <!-- 连接注意事项浮层（覆盖当前页面，居中窗口） -->
        <BoxView x:Name="NotesScrim"
                 Color="#B0000000"
                 Opacity="0"
                 IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNotesCloseClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="NotesCard"
                IsVisible="False"
                BackgroundColor="#161B22"
                Stroke="#A371F7"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 16"
                Padding="20,18"
                WidthRequest="360"
                MaximumHeightRequest="880"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Opacity="0"
                Scale="0.94">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Label Text="连接注意事项"
                       TextColor="#E6EDF3" FontSize="18" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <ScrollView Grid.Row="1" MaximumHeightRequest="680">
                    <Label x:Name="NotesLabel"
                           TextColor="#C9D1D9" FontSize="14"
                           LineBreakMode="WordWrap" />
                </ScrollView>
                <Button Grid.Row="2"
                        Text="知道了"
                        Clicked="OnNotesCloseClicked"
                        BackgroundColor="#A371F7" TextColor="#FFFFFF"
                        HeightRequest="44" CornerRadius="10" FontSize="15" />
            </Grid>
        </Border>

        <!-- 应用内共享选择弹窗 -->
        <controls:SharePickerView x:Name="SharePicker" />
    </Grid>

</ContentPage>
